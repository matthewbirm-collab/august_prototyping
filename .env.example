# Copy to .env and fill in. Never commit .env.
# Defaults below match the parameter table in CLAUDE.md.

ENV=development
LOG_LEVEL=INFO

# Local Homebrew Postgres connects as your macOS user with no password.
DATABASE_URL=postgresql+psycopg://localhost:5432/propline
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/propline_test
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]

# The Odds API (https://the-odds-api.com). Leave empty until you have an account.
ODDS_PROVIDER=the_odds_api
ODDS_API_KEY=
ODDS_API_REGIONS=us

# Odds adapter. 15/day fits the free plan (500 credits/month); raise it on a paid plan.
DAILY_CREDIT_BUDGET=15
# Scheduler: poll every interval_minutes while kickoff is at least min_hours_to_kickoff away
POLL_TIERS=[{"min_hours_to_kickoff":72,"interval_minutes":720},{"min_hours_to_kickoff":24,"interval_minutes":180},{"min_hours_to_kickoff":3,"interval_minutes":60},{"min_hours_to_kickoff":0,"interval_minutes":15}]
# Games kicking off within this many days are polled
POLL_HORIZON_DAYS=7
# Consensus
STALE_QUOTE_MINUTES=90
# Player resolver
FUZZY_MATCH_THRESHOLD=90
# Steam and stale-line detection
STEAM_MIN_BOOKS=3
STEAM_WINDOW_MIN=10
STALE_LINE_PROB_PTS=5
STALE_LINE_MIN=30
# Context attribution
CONTEXT_LOOKBACK_HOURS=24
# Alerts
ALERT_THRESHOLD_PTS=2.0
ALERT_DIGEST_MIN=15
# The isolated QB prototype reads this key; never commit your real key.
PROPLINE_API_KEY=
